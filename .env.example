# -----------------------------------------------------------------------------
# AWS (leave EMPTY for local/small mode — see DEPLOYMENT_MODES.md)
# Fill when ready for large-scale: S3 uploads (vercel-app) + ECR push (CI).
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ECR_REGISTRY=
AWS_S3_BUCKET=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=workflow_engine
POSTGRES_USER=workflow_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_URL=postgresql+asyncpg://workflow_user:change_me_in_production@postgres:5432/workflow_engine

# Spring Boot (workflow-engine)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/workflow_engine
SPRING_DATASOURCE_USERNAME=workflow_user
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Service URLs (Docker network)
# -----------------------------------------------------------------------------
WORKFLOW_ENGINE_URL=http://workflow-engine:8080
TRANSFORM_SERVICE_URL=http://transform-service:8001
API_GATEWAY_URL=http://api-gateway:8000

# -----------------------------------------------------------------------------
# API Gateway
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8000
API_KEY_CACHE_TTL=300
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET=change_me_jwt_secret_min_32_chars
# Leave empty in production. For local/dev, set a bootstrap admin key (shown once in docs).
DEFAULT_ADMIN_API_KEY=

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_UPLOADS_PER_MINUTE=10

# File upload
UPLOAD_DIR=/data/input
MAX_UPLOAD_SIZE_MB=500

# -----------------------------------------------------------------------------
# Workflow Engine (Java)
# -----------------------------------------------------------------------------
WORKFLOW_ENGINE_PORT=8080
FILE_WATCH_DIRECTORIES=/data/input
FILE_WATCH_POLL_INTERVAL_MS=5000

# Redis stream names
REDIS_STREAM_WORKFLOW_EVENTS=workflow:events
REDIS_STREAM_TRANSFORM_EVENTS=transform:events
REDIS_STREAM_STATUS_EVENTS=status:events
REDIS_STREAM_DEAD_LETTER=workflow:dead-letter

# -----------------------------------------------------------------------------
# Transform Service (Python)
# -----------------------------------------------------------------------------
TRANSFORM_SERVICE_PORT=8001
TRANSFORM_CHUNK_SIZE=50000
PARQUET_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_KEY=
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
