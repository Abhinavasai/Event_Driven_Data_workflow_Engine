# -----------------------------------------------------------------------------
# Runtime mode
#   local (default) — SQLite metadata + local filesystem uploads (small use cases)
#   aws             — same SQLite metadata + S3 uploads (large-scale file storage)
# Auto-selects aws when AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY + AWS_S3_BUCKET are set.
# -----------------------------------------------------------------------------
RUNTIME_MODE=

# Local storage (SQLite DB + uploads). On Vercel serverless, prefer /tmp.
STORAGE_DIR=
SQLITE_PATH=

# Seeded on first boot if no API keys exist
DEFAULT_ADMIN_API_KEY=dev-admin-key-change-me

# Auto-fill dashboard/cleaned-data demo when runs store is empty (default: on)
# Set to false to skip. Recommended true on Vercel so deploys aren't blank.
AUTO_SEED_DEMO=true

# -----------------------------------------------------------------------------
# AWS (leave EMPTY for local/small mode). Fill all four to enable S3 file store.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
